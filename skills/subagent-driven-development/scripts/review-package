#!/usr/bin/env bash
# Compatibility launcher; PowerShell users invoke sdd.py directly.
set -euo pipefail
script_dir="$(cd "$(dirname "$0")" && pwd)"
if python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
  runtime=python3
elif python -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
  runtime=python
else
  echo "sdd: Python 3.10+ is required (python3 or python on PATH)" >&2
  exit 2
fi
exec "$runtime" "$script_dir/sdd.py" review "$@"
